{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/shop",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/shop/:path*",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/podcast",
      "destination": "/resources",
      "permanent": true
    },
    {
      "source": "/podcast/:path*",
      "destination": "/resources",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/telehealth",
      "destination": "/telehealth",
      "permanent": true
    },
    {
      "source": "/online",
      "destination": "/telehealth",
      "permanent": true
    },
    {
      "source": "/online-consultations",
      "destination": "/telehealth",
      "permanent": true
    },
    {
      "source": "/consulting",
      "destination": "/teams",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/resources",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/resources",
      "permanent": true
    },
    {
      "source": "/media",
      "destination": "/resources",
      "permanent": true
    },
    {
      "source": "/booking",
      "destination": "/book",
      "permanent": true
    },
    {
      "source": "/book-online",
      "destination": "/book",
      "permanent": true
    },
    {
      "source": "/appointments",
      "destination": "/book",
      "permanent": true
    },
    {
      "source": "/bowling-workload",
      "destination": "/bowling",
      "permanent": true
    },
    {
      "source": "/workload",
      "destination": "/bowling",
      "permanent": true
    },
    {
      "source": "/injuries",
      "destination": "/cricket-injuries",
      "permanent": true
    },
    {
      "source": "/faqs",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/memberships",
      "destination": "/cricket-performance",
      "permanent": true
    },
    {
      "source": "/membership",
      "destination": "/cricket-performance",
      "permanent": true
    },
    {
      "source": "/performance",
      "destination": "/cricket-performance",
      "permanent": true
    },
    {
      "source": "/clubs",
      "destination": "/cricket-performance/clubs",
      "permanent": true
    },
    {
      "source": "/club-support",
      "destination": "/cricket-performance/clubs",
      "permanent": true
    },
    {
      "source": "/players",
      "destination": "/cricket-performance/players",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(.*).(css|js|svg|png|jpg|jpeg|webp|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
