{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/shop", "destination": "/", "permanent": true },
    { "source": "/shop/:path*", "destination": "/", "permanent": true },
    { "source": "/podcast", "destination": "/resources", "permanent": true },
    { "source": "/podcast/:path*", "destination": "/resources", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/teams", "destination": "/organisations", "permanent": true },
    { "source": "/consulting", "destination": "/organisations", "permanent": true },
    { "source": "/services", "destination": "/players", "permanent": true },
    { "source": "/telehealth", "destination": "/players", "permanent": true },
    { "source": "/in-person", "destination": "/players", "permanent": true },
    { "source": "/book", "destination": "/players", "permanent": true },
    { "source": "/return-to-performance", "destination": "/players", "permanent": true },
    { "source": "/faq", "destination": "/players", "permanent": true },
    { "source": "/services/telehealth", "destination": "/players", "permanent": true },
    { "source": "/online", "destination": "/players", "permanent": true },
    { "source": "/online-consultations", "destination": "/players", "permanent": true },
    { "source": "/booking", "destination": "/players", "permanent": true },
    { "source": "/book-online", "destination": "/players", "permanent": true },
    { "source": "/appointments", "destination": "/players", "permanent": true },
    { "source": "/faqs", "destination": "/players", "permanent": true },
    { "source": "/blog", "destination": "/resources", "permanent": true },
    { "source": "/blog/:path*", "destination": "/resources", "permanent": true },
    { "source": "/media", "destination": "/resources", "permanent": true },
    { "source": "/bowling-workload", "destination": "/bowling", "permanent": true },
    { "source": "/workload", "destination": "/bowling", "permanent": true },
    { "source": "/injuries", "destination": "/cricket-injuries", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/(.*).(css|js|svg|png|jpg|jpeg|webp|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
